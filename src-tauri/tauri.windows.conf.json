{
  "bundle": {
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/juggl-custode",
      "binaries/whisper-cli"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Italian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": false
  },
  "mainBinaryName": "Juggl",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Juggl",
        "width": 1180,
        "height": 780,
        "minWidth": 380,
        "minHeight": 480,
        "decorations": false,
        "shadow": true
      }
    ]
  }
}
