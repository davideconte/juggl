{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Juggl",
  "mainBinaryName": "Juggl",
  "version": "0.1.107",
  "identifier": "dev.juggl.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Juggl",
        "width": 1180,
        "height": 780,
        "minWidth": 380,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**",
            "/private/tmp/**",
            "/tmp/**",
            "/private/var/folders/**",
            "/Volumes/**"
          ],
          "deny": [],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Juggl.entitlements"
    },
    "createUpdaterArtifacts": false,
    "resources": {
      "../resources/": "resources/"
    },
    "copyright": "Juggl",
    "category": "DeveloperTool"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4NTBFRDNEOTgwM0QzMzMKUldRejB3T1lQZTFRV0pKdVR5dHRRTi9VMjhWRTZyZWJsaFFDQlBoWFVwcnVRQXIweGFQT00zcTYK",
      "endpoints": [
        "https://juggl.dev/api/aggiornamento/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
